# Build context is the flashsale/ directory.
#
# The service module has a "replace" directive pointing at ../common, so the
# shared module must be present next to it in the builder for the build to
# resolve.
FROM golang:1.23-alpine AS builder

WORKDIR /src

COPY common/ ./common/
COPY api-gateway/go.mod api-gateway/go.sum ./api-gateway/

WORKDIR /src/api-gateway
RUN go mod download

COPY api-gateway/ ./

# A static binary lets the runtime image stay minimal.
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/api-gateway .

FROM alpine:3.20

RUN apk add --no-cache ca-certificates \
    && adduser -D -u 10001 app

COPY --from=builder /out/api-gateway /usr/local/bin/api-gateway

# Run unprivileged: the service needs no root capabilities.
USER app
WORKDIR /home/app

EXPOSE 8080

ENTRYPOINT ["api-gateway"]
