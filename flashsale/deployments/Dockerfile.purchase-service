# Build context is the flashsale/ directory.
#
# The service module has a "replace" directive pointing at ../common, so the
# shared module must be present next to it in the builder for the build to
# resolve.
FROM golang:1.23-alpine AS builder

WORKDIR /src

COPY common/ ./common/
COPY purchase-service/go.mod purchase-service/go.sum ./purchase-service/

WORKDIR /src/purchase-service
RUN go mod download

COPY purchase-service/ ./

# A static binary lets the runtime image stay minimal.
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/purchase-service .

FROM alpine:3.20

RUN apk add --no-cache ca-certificates \
    && adduser -D -u 10001 app

COPY --from=builder /out/purchase-service /usr/local/bin/purchase-service

# Run unprivileged: the service needs no root capabilities.
USER app
WORKDIR /home/app

EXPOSE 8081

ENTRYPOINT ["purchase-service"]
