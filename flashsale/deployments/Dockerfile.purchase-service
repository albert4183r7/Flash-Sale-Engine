# =============================================================================
# Purchase Service - Multi-stage Distroless Dockerfile
# HOT PATH - Critical for flash sales
# =============================================================================

# Stage 1: Build
FROM golang:1.23 AS builder

WORKDIR /app

COPY purchase-service/go.mod purchase-service/go.sum ./
RUN go mod download

COPY purchase-service/ .

# Build with optimizations
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-w -s -X main.version=${VERSION:-dev}" \
    -o /purchase-service .

# Stage 2: Runtime (Distroless)
FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder /purchase-service /purchase-service

USER nonroot:nonroot

EXPOSE 8081

ENTRYPOINT ["/purchase-service"]
