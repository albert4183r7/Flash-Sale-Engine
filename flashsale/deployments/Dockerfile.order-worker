# Build context is the flashsale/ directory.
#
# The service module has a "replace" directive pointing at ../common, so the
# shared module must be present next to it in the builder for the build to
# resolve.
FROM golang:1.23-alpine AS builder

WORKDIR /src

COPY common/ ./common/
COPY order-worker/go.mod order-worker/go.sum ./order-worker/

WORKDIR /src/order-worker
RUN go mod download

COPY order-worker/ ./

# A static binary lets the runtime image stay minimal.
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/order-worker .

FROM alpine:3.20

RUN apk add --no-cache ca-certificates \
    && adduser -D -u 10001 app

COPY --from=builder /out/order-worker /usr/local/bin/order-worker

# Run unprivileged: the service needs no root capabilities.
USER app
WORKDIR /home/app

ENTRYPOINT ["order-worker"]
