# Copy to .env and adjust. Never commit the real .env: it is git-ignored.
#
# Two of these values are secrets and MUST be replaced before any deployment
# that is not a throwaway local one:
#   JWT_SECRET          signs access tokens; anyone who knows it can forge them
#   INTERNAL_API_TOKEN  authenticates the gateway to the purchase service
# Generate each with:  openssl rand -hex 32

# --- APPLICATION ---
ENV=development
API_GATEWAY_PORT=8080
PURCHASE_SERVICE_PORT=8081

# Must be at least 16 characters; the gateway refuses to start otherwise.
JWT_SECRET=replace_me_with_a_long_random_value
INTERNAL_API_TOKEN=replace_me_with_a_long_random_value

# --- SERVICE DISCOVERY ---
PURCHASE_SERVICE_URL=http://localhost:8081

# --- REDIS ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# --- POSTGRESQL ---
# Connection details are given as parts and the services assemble the URL. That
# keeps credentials out of this file, and lets docker-compose.yml redirect a
# service to another host by overriding POSTGRES_HOST alone.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=flashsale
POSTGRES_SSLMODE=disable

# Optional: set a complete URL to bypass the parts above, for a managed
# database or a connection pooler.
# POSTGRES_URL=

# --- RABBITMQ ---
# Left blank, the AMQP client applies its own defaults, which match a stock
# local RabbitMQ.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=

# Optional: set a complete URL to bypass the parts above.
# RABBITMQ_URL=

# --- OPTIONAL TUNING (defaults shown) ---
# TOKEN_TTL=24h
# CREDENTIAL_CACHE_TTL=1h
# IDEMPOTENCY_TTL=2m
# RATE_LIMIT_REQUESTS=120
# RATE_LIMIT_WINDOW=1m
# SHUTDOWN_TIMEOUT=15s
# DB_TIMEOUT=10s

# Password for the accounts created by scripts/seed.go (development only).
# SEED_PASSWORD=
