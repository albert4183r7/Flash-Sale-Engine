# --- COMMON SETTINGS ---
ENV=development
API_GATEWAY_PORT=
PURCHASE_SERVICE_PORT=8081
JWT_SECRET=<Your-Secret-Key>

# --- INFRASTRUCTURE (Common) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# --- DATABASE (Shared Settings) ---
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_DB=flashsale

# ==========================================
# 🛠️ MODE SELECTION (Uncomment one block)
# ==========================================

# --- OPTION A: DOCKER MODE ---
# POSTGRES_HOST=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:{POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
# PURCHASE_SERVICE_URL=http://purchase-service:8081

# --- OPTION B: LOCAL MODE (Current) ---
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=
POSTGRES_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
PURCHASE_SERVICE_URL=http://localhost:8081