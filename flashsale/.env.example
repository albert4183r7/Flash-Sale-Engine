# Common
PORT=8080
ENV=development

# Postgres (Database)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_password_here
POSTGRES_DB=flashsale
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_URL=postgres://postgres:secure_password_here@postgres:5432/flashsale?sslmode=disable

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Security
JWT_SECRET=replace_this_with_a_long_secure_random_string

# Service URLs
PURCHASE_SERVICE_URL=http://purchase-service:8081
```json
// To load these in Go, we will use "[github.com/joho/godotenv](https://github.com/joho/godotenv)"
// in the main.go of each service before loading config.