# ===========================================
# Flash Sale Engine - Microservices Configuration
# ===========================================
# Copy this file to .env and update values as needed

# --- COMMON SETTINGS ---
ENV=development
JWT_SECRET=ef2d832b27147d3f795054b500c13050f6b36af7e366d7f9e567359ce5df3b81

# --- GATEWAY ---
API_GATEWAY_PORT=8080

# --- INFRASTRUCTURE ---
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# --- DATABASE CREDENTIALS ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ===========================================
# SERVICE DATABASE URLS (Docker Mode)
# ===========================================
# These are the internal Docker network URLs used by services

USER_POSTGRES_URL=postgres://postgres:postgres@user-db:5432/flashsale_users?sslmode=disable
PRODUCT_POSTGRES_URL=postgres://postgres:postgres@product-db:5432/flashsale_products?sslmode=disable
ORDER_POSTGRES_URL=postgres://postgres:postgres@order-db:5432/flashsale_orders?sslmode=disable

# ===========================================
# SERVICE URLS (Docker Mode)
# ===========================================
# Internal service-to-service communication

USER_SERVICE_URL=http://user-service:8082
PRODUCT_SERVICE_URL=http://product-service:8083
ORDER_SERVICE_URL=http://order-service:8084
PURCHASE_SERVICE_URL=http://purchase-service:8081

# ===========================================
# SEEDING DATABASE URLS (Local/Host Mode)
# ===========================================
# Use these when running seed.go from host machine
# Uncomment and use these for local seeding:
#
# USER_POSTGRES_URL=postgres://postgres:postgres@localhost:5433/flashsale_users?sslmode=disable
# PRODUCT_POSTGRES_URL=postgres://postgres:postgres@localhost:5434/flashsale_products?sslmode=disable
# ORDER_POSTGRES_URL=postgres://postgres:postgres@localhost:5435/flashsale_orders?sslmode=disable