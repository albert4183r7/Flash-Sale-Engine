# Copy to .env and fill in the blanks. .env is git-ignored; never commit it.
#
# Required before the first `docker compose up`:
#   POSTGRES_PASSWORD, RABBITMQ_PASSWORD   any value you choose
#   JWT_SECRET, INTERNAL_API_TOKEN         generate with: openssl rand -hex 32

# --- APPLICATION ---
ENV=development
API_GATEWAY_PORT=8080
PURCHASE_SERVICE_PORT=8081

# JWT_SECRET must be at least 16 characters; the gateway refuses to start otherwise.
JWT_SECRET=
INTERNAL_API_TOKEN=

# --- SERVICE DISCOVERY ---
PURCHASE_SERVICE_URL=http://localhost:8081

# --- REDIS ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# --- POSTGRESQL ---
# The services build the connection URL from these parts. Set POSTGRES_URL
# instead to use a complete URL (managed database, connection pooler).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=flashsale
POSTGRES_SSLMODE=disable
# POSTGRES_URL=

# --- RABBITMQ ---
# Built from these parts, or set RABBITMQ_URL to override them.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=flashsale
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=
# RABBITMQ_URL=

# --- OPTIONAL TUNING (defaults shown) ---
# TOKEN_TTL=24h
# CREDENTIAL_CACHE_TTL=1h
# IDEMPOTENCY_TTL=2m
# RATE_LIMIT_REQUESTS=120
# RATE_LIMIT_WINDOW=1m
# SHUTDOWN_TIMEOUT=15s
# DB_TIMEOUT=10s

# Password for the demo accounts created by scripts/seed.go (development only).
# SEED_PASSWORD=
