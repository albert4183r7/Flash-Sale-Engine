# =============================================================================
# Flash Sale Engine - Environment Configuration
# =============================================================================
# Copy this file to .env and update values as needed
# cp .env.example .env

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL credentials (shared across services)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Service-specific database URLs (Docker Compose uses these)
USER_POSTGRES_URL=postgres://postgres:postgres@user-db:5432/flashsale_users?sslmode=disable
PRODUCT_POSTGRES_URL=postgres://postgres:postgres@product-db:5432/flashsale_products?sslmode=disable
ORDER_POSTGRES_URL=postgres://postgres:postgres@order-db:5432/flashsale_orders?sslmode=disable

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# =============================================================================
# MESSAGE QUEUE (Local Development)
# =============================================================================

# RabbitMQ for local development
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# AWS SQS for production (leave empty for local dev)
SQS_QUEUE_URL=
AWS_REGION=ap-southeast-1

# =============================================================================
# AUTHENTICATION
# =============================================================================

# JWT secret key (generate with: openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
TOKEN_EXPIRY=24h

# =============================================================================
# SERVICE PORTS
# =============================================================================

API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8082
PRODUCT_SERVICE_PORT=8083
ORDER_SERVICE_PORT=8084
PURCHASE_SERVICE_PORT=8081

# =============================================================================
# SERVICE URLS (used by API Gateway & Workers)
# =============================================================================

USER_SERVICE_URL=http://user-service:8082
PRODUCT_SERVICE_URL=http://product-service:8083
ORDER_SERVICE_URL=http://order-service:8084
PURCHASE_SERVICE_URL=http://purchase-service:8081

# =============================================================================
# RATE LIMITING
# =============================================================================

RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60s